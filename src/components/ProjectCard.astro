---
// One project card: the screenshot slot, the title and date, the org line, the
// bullets, and the repo link glued to the foot. `img` and `github` are the only
// optional parts — an empty one falls back to a labelled placeholder, so a
// project that is not finished yet still renders a complete-looking card.
//
// The styling all lives in the page's global block, so this component carries
// no <style> of its own: a card is the sign's timber wherever it happens to land.
const { project: p } = Astro.props;
---

<article class="entry entry-shot">
  <div class="shot">
    {p.img ? (
      <img src={p.img} alt={`${p.title} screenshot`} loading="lazy" />
    ) : (
      <span class="shot-empty">Screenshot</span>
    )}
  </div>
  <div class="eh">
    <h3>{p.title}</h3>
    <span class="when">{p.when}</span>
  </div>
  {p.org && <p class="org">{p.org}</p>}
  <ul>
    {p.pts.map((pt) => (
      <li>{pt}</li>
    ))}
  </ul>
  {p.github ? (
    <a class="card-link" href={p.github} target="_blank" rel="noopener">
      GitHub ↗
    </a>
  ) : (
    <span class="card-link is-empty">GitHub — add a repo</span>
  )}
</article>

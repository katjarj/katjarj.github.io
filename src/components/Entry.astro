---
import Symbol from './Symbol.astro';
const { title, org, when, pts = [], diff } = Astro.props;
---
<article class="e">
  <div class="hd"><h3>{diff && <span class="diff"><Symbol diff={diff} label /></span>}{title}</h3><span class="when">{when}</span></div>
  {org && <p class="org">{org}</p>}
  {pts.length > 0 && <ul>{pts.map((p) => <li>{p}</li>)}</ul>}
</article>

---
import Arrow from './Arrow.astro';
import Symbol from './Symbol.astro';

// One sign: a cap, a board of runs and a post. Every sign on the site is one
// of these, so making another is a data array and a single call — the styles
// and the click behaviour are generic and come along for free.
//
// A run is { id, title, diff, dir }. `diff` is the trail rating, and it drives
// both the row's colour and its symbol from one value, so the two cannot drift
// apart. A run with no `diff` is unrated: it wears `run-back` and carries no
// symbol, which is what the Back row is.
const { cap, runs = [] } = Astro.props;
---

<div class="sign-wrap">
  <div class="sign-cap">{cap}</div>
  <div class="sign-board">
    {runs.map((r) => (
      <button
        class={`run-btn run-${r.diff || 'back'}`}
        id={r.id ? `btn-${r.id}` : undefined}
        data-dir={r.dir}
        data-target={r.back ? undefined : r.id}
        data-back={r.back ? 'true' : undefined}
      >
        <span class="run-arrow">
          <Arrow dir={r.dir} />
        </span>
        <span class="run-label">
          <span class="run-name">{r.title}</span>
          {r.diff && (
            <span class="run-tag">
              <Symbol diff={r.diff} />
            </span>
          )}
        </span>
      </button>
    ))}
  </div>
  <div class="post-shaft"></div>
</div>

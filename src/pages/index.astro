---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import {
  links,
  intro,
  trailMap,
  experience,
  experienceGroups,
  projects,
  projectCategories,
  extracurricular,
  resume,
  skills,
} from '../data/resume.js';
import Sign from '../components/Sign.astro';
import Card from '../components/Card.astro';
import Arrow from '../components/Arrow.astro';

// Every experience entry, in the order the sub-signs list them, tagged by group.
const groupOf = (id: string) => experience.filter((e) => e.group === id);

// Extracurricular is carded per organisation rather than per role, so one
// card holds everything held under that org — a club's three positions sit
// together instead of repeating the club's name three times down the page.
// Generic, so the entry type survives: the old `{ org: string }[]` parameter
// widened every item to just its org and dropped title/when/pts from the type,
// even though the values were all still there at runtime.
const byOrg = <T extends { org: string }>(arr: T[]) => {
  const seen = new Map<string, T[]>();
  for (const e of arr) {
    if (!seen.has(e.org)) seen.set(e.org, []);
    seen.get(e.org)!.push(e);
  }
  return [...seen].map(([org, items]) => ({ org, items }));
};
const ORGS = byOrg(extracurricular);

// The reverse of a run's direction — which way a Back retraces it. This is the
// build-time twin of MIRROR in the script below, and it exists so a card
// page's Back arrow is DERIVED from the run that reached it rather than typed
// in by hand: hand-written arrows drift the moment a run changes direction.
// The two maps must stay identical; a card page's back pan is driven by the
// same value, so a mismatch shows up as an arrow that lies about the pan.
const MIRROR_DIR: Record<string, string> = {
  left: 'right',
  right: 'left',
  upleft: 'upright',
  up: 'upleft',
  upright: 'upleft',
};
// A card page is always reached by exactly one run, so its way back is a
// constant of the page, not of the journey. This reads that run's direction
// off the parent sign rather than restating it.
const backOf = (runs: { id: string; dir: string }[], id: string) => {
  const run = runs.find((r) => r.id === id);
  return run ? MIRROR_DIR[run.dir] : 'left';
};

// Projects gets its own sign too: the three categories, then Back.
// Back points up-right, the reverse of the blue up-left run that reached this
// sign, so it is the way home. That leaves ←, ↖ and → for the categories.
const PROJECT_DIRS = ['left', 'upleft', 'right'];
const projectLayers = projectCategories
  .map((c, i) => {
    const dir = PROJECT_DIRS[i] || 'left';
    return {
      ...c,
      dir,
      backDir: MIRROR_DIR[dir],
      items: projects.filter((p) => p.cat === c.id),
      layer: `layer-${c.id}`,
    };
  })
  .filter((c) => c.items.length > 0);
const projectRuns = [
  ...projectLayers.map((c) => ({
    id: c.id,
    title: c.title,
    diff: c.diff,
    dir: c.dir,
  })),
  { title: 'Back to Trail Map', dir: 'upright', back: true },
];

// Four options fan out the way the main sign does: ←, ↖, ↗, →. The three
// groups take the first three; the Back row below is the fourth and takes →.
// Left and right are the long two-period traverses, the angled pair one period
// each, so each arrow is matched by its pan distance.
const DIRS = ['left', 'upleft', 'upright'];
const LAYERS = experienceGroups
  .map((g, i) => {
    const dir = DIRS[i] || 'upleft';
    return {
      ...g,
      dir,
      backDir: MIRROR_DIR[dir],
      entries: groupOf(g.id),
      layer: `layer-${g.id}`,
    };
  })
  .filter((g) => g.entries.length > 0);

// The sub-sign's runs, in the order the groups list them, plus the Back row.
// `back: true` is all it takes to make a row unrated: Sign.astro gives it the
// run-back styling, no symbol, and Back behaviour.
const subRuns = [
  ...LAYERS.map((g) => ({
    id: g.id,
    title: g.title,
    diff: g.diff,
    dir: g.dir,
  })),
  { title: 'Back to Trail Map', dir: 'right', back: true },
];

// Note for the signs that do exist: a generated layer id must be `layer-` plus
// the run's id, because the click handler builds the target by prefixing
// `layer-` to `data-target`, which Sign.astro sets from `r.id`. Anything else
// and showLayer finds nothing and the screen goes blank.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Katja Radovic-Jonsson</title>
    <meta name="description" content="Katja Radovic-Jonsson's personal website" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'%3E%3Cpath d='M2 1.5V8.5M8.5 1.5L2 5l6.5 3.5' stroke='%233B2A3F' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
    <script is:inline>
      try {
        var m = localStorage.getItem('mode');
        if (!m) m = matchMedia('(prefers-color-scheme:dark)').matches ? 'night' : 'day';
        document.documentElement.dataset.mode = m;
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Mode button (always on top) -->
    <button id="mode-btn" type="button">
      night ski
    </button>

    <!-- ══════════════════════════════════════════════
       WORLD — one canvas paints the whole scene.
       The landing page IS this scene at camera (0,0);
       every run is the same scene with the camera panned,
       so the environment never changes, it only moves.
  ══════════════════════════════════════════════ -->
    <canvas id="world" aria-hidden="true"></canvas>

    <!-- ══════════════════════════════════════════════
       LAYER: LANDING — the trail sign
  ══════════════════════════════════════════════ -->
    <div id="layer-landing" class="layer active">
      <header class="site-header">
        <h1>{intro.name}</h1>
      </header>

      <Sign cap="TRAIL MAP" runs={trailMap} />

      <!-- The wheel does something here that no other page does: it dives, and
           the résumé comes up out of the snow. Nothing on the sign says so, and
           the page itself never scrolls, so the gesture is invisible until you
           try it. This is the sign's own down arrow (Arrow.astro `down`) and
           three words under the post. aria-hidden: a screen-reader user reads
           the résumé from the link above, and the dive is not a thing they can
           do, so a spoken hint would be noise. -->
      <p class="dive-cue" id="dive-cue" aria-hidden="true">
        <span>scroll for my resume!</span>
        <Arrow dir="down" />
      </p>
    </div>

    <!-- ══════════════════════════════════════════════
         CONTACT — the two bears live OUTSIDE every .layer, so they stay put
         on every page instead of vanishing on the first run. The credit sits
         with them for the same reason.
    ══════════════════════════════════════════════ -->
    <!-- The label is real text laid on the bear's flank rather than baked into
         the PNG, so it stays selectable and readable by a screen reader. -->
    <div class="bears">
      <a class="bear" href={links.linkedin} target="_blank" rel="noopener">
        <img src="/bear.png" alt="" aria-hidden="true" />
        <span class="bear-text">LinkedIn</span>
      </a>
      <a class="bear" href={links.github} target="_blank" rel="noopener">
        <img src="/bear.png" alt="" aria-hidden="true" />
        <span class="bear-text">GitHub</span>
      </a>
    </div>

    <p class="credit">
      <a href="https://www.flaticon.com/free-icons/bear" title="bear icons">
        Bear icons created by Victoruler - Flaticon
      </a>
    </p>

    <!-- ══════════════════════════════════════════════
       SECTION LAYERS — same world behind, text overlay
  ══════════════════════════════════════════════ -->

    <!-- ══════════════════════════════════════════════
       EXPERIENCE — a second trail sign, reached from the green run.
       Same <Sign> as the landing page: cap, board of runs, post.
  ══════════════════════════════════════════════ -->
    <div id="layer-experience" class="layer sub-layer">
      <Sign cap="EXPERIENCE" runs={subRuns} />
    </div>

    <!-- One list layer per group on the sub-sign, each its own run. -->
    {LAYERS.map((g) => (
      <div id={g.layer} class="layer section-layer">
        <div class="sec-scroll">
          <div class="sec-inner">
            <button class="back-btn" data-back data-dir={g.backDir}>
              <span class="back-arrow" aria-hidden="true">
                <Arrow dir={g.backDir} />
              </span>{' '}
              Experience
            </button>
            <h2>{g.title}</h2>
            <div class="entries">
              {g.entries.map((e) => (
                <Card entry={e} />
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- ══════════════════════════════════════════════
         PROJECTS — a sign of its own, reached from the blue run.
         Back points up-right, the way home to the trail map.
    ══════════════════════════════════════════════ -->
    <div id="layer-projects" class="layer sub-layer">
      <Sign cap="PROJECTS" runs={projectRuns} />
    </div>

    {projectLayers.map((c) => (
      <div id={c.layer} class="layer section-layer">
        <div class="sec-scroll">
          <div class="sec-inner">
            <button class="back-btn" data-back data-dir={c.backDir}>
              <span class="back-arrow" aria-hidden="true">
                <Arrow dir={c.backDir} />
              </span>{' '}
              Projects
            </button>
            <h2>{c.title}</h2>
            <div class="entries entries-2">
              {c.items.map((p) => (
                <Card entry={p} />
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}

    <!-- Extracurricular (black) -->
    <div id="layer-community" class="layer section-layer">
      <div class="sec-scroll">
        <div class="sec-inner">
          <button class="back-btn" data-back data-dir={backOf(trailMap, 'community')}>
            <span class="back-arrow" aria-hidden="true">
              <Arrow dir={backOf(trailMap, 'community')} />
            </span>{' '}
            Trail Map
          </button>
          <h2>Extracurricular</h2>
          <div class="entries">
            {ORGS.map((g) => (
              <article class="entry entry-org">
                <h3 class="org-name">{g.org}</h3>
                {g.items.map((c) => (
                  <div class="role">
                    <div class="eh">
                      <h4>{c.title}</h4>
                      <span class="when">{c.when}</span>
                    </div>
                    <ul>
                      {c.pts.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Skills: one page, banded by a header per category — no sub-sign, because
         the categories are not a choice, they are one list. -->
    <div id="layer-skills" class="layer section-layer">
      <div class="sec-scroll">
        <div class="sec-inner">
          <button class="back-btn" data-back data-dir={backOf(trailMap, 'skills')}>
            <span class="back-arrow" aria-hidden="true">
              <Arrow dir={backOf(trailMap, 'skills')} />
            </span>{' '}
            Trail Map
          </button>
          <h2>Skills</h2>
          <div class="entries">
            {skills.map((s) => (
              <article class="entry entry-org">
                <h3 class="org-name">{s.title}</h3>
                <p class="skill-items">{s.items}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════
         RÉSUMÉ — reached by scrolling DOWN from the landing, not by a
         run. The world keeps sitting exactly where it is; this scrolls over
         it, like any other page. There is no Back button here: the way
         back out of the snow is to scroll up off the top of the page.
    ══════════════════════════════════════════════ -->
    <div id="layer-resume" class="layer section-layer">
      <div class="sec-scroll">
        <div class="sec-inner">
          <h2>{resume.heading}</h2>
          <p class="resume-note">{resume.note}</p>
          <a class="dl-btn" href={resume.file} download>
            Download the PDF
          </a>
          <!-- The pages are rasterised from the PDF and mounted on first reveal,
               so the site is not carrying 787KB of résumé on every visit. The
               list rides on the slot rather than being closed over, so it stays
               visible in the DOM. -->
          <div
            class="resume-pages"
            id="resume-pages"
            data-pages={JSON.stringify(resume.pages)}
          ></div>
        </div>
      </div>
    </div>

    <script>
      // ─── Helpers ────────────────────────────────────────────────────
      const root = document.documentElement;
      const allLayers = [...document.querySelectorAll<HTMLElement>('.layer')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      function getVar(name: string): string {
        return getComputedStyle(root).getPropertyValue(name).trim();
      }

      // Seeded RNG: the world is generated from fixed seeds, so it looks
      // identical on every load, on every page, at every moment.
      function srng(seed: number) {
        let s = seed;
        return () => {
          s = (s * 16807) % 2147483647;
          return s / 2147483647;
        };
      }

      // ─── Mode toggle ────────────────────────────────────────────────
      const modeBtn = document.getElementById('mode-btn')!;
      function syncLabel() {
        modeBtn.textContent = root.dataset.mode === 'night' ? 'bluebird' : 'night ski';
      }
      syncLabel();

      // Long enough for the sun to actually cross the ridge, short enough that
      // it does not become an event you wait for.
      const MODE_MS = 1300;
      let modeRaf = 0;
      // This view looks west. That fixes which way the sun is allowed to move:
      // a sunset is in front of you and goes down into the frame, but a sunrise
      // comes up behind your back — so switching to day must NOT show a sun
      // rising. Only the way down gets one. The golden light either way is
      // still right: dawn is warm too, it just arrives from off-screen.
      let sunSets = false;
      function runModeChange(to: number) {
        if (modeRaf) cancelAnimationFrame(modeRaf);
        const from = blend;
        sunSets = to > from; // going to night is the sunset
        MID = sunSets ? GOLD : DAWN; // ...and the hour it passes through
        const t0 = performance.now();
        const step = () => {
          const k = Math.min(1, (performance.now() - t0) / MODE_MS);
          // smoothstep. easeInOutQuad and smootherstep were both tried and
          // are WORSE here: their curves are more peaked (max rate 2.0 and
          // 1.875 against smoothstep's 1.5), so they concentrate more of the
          // change into the middle — exactly the surge this is smoothing out.
          const e = k * k * (3 - 2 * k);
          blend = from + (to - from) * e;
          paintChrome(blend);
          draw();
          if (k < 1) {
            modeRaf = requestAnimationFrame(step);
          } else {
            modeRaf = 0;
            blend = to;
            // hand the colours back to the stylesheet, which is where they
            // live the rest of the time
            releaseChrome();
          }
        };
        modeRaf = requestAnimationFrame(step);
      }

      modeBtn.addEventListener('click', () => {
        const next = root.dataset.mode === 'night' ? 'day' : 'night';
        root.dataset.mode = next;
        try {
          localStorage.setItem('mode', next);
        } catch (e) {}
        syncLabel();
        if (reduced) {
          // no sun, no fade: the two scenes just swap, as they always did
          if (modeRaf) cancelAnimationFrame(modeRaf);
          modeRaf = 0;
          releaseChrome();
          blend = next === 'night' ? 1 : 0;
          draw();
          return;
        }
        runModeChange(next === 'night' ? 1 : 0);
      });

      // ─── Layer switching ─────────────────────────────────────────────
      // The world behind these layers never changes; only the sign and the
      // text come and go over it.
      // The bears stand on the snow beside a sign, so they belong only on a
      // layer that actually has one — and they dip out during the pan between
      // pages, so they never hang over a page that has no sign under them.
      //
      // The credit is NOT in this group. It is a licence attribution, not
      // decoration, so it stays on every page a person might read — including
      // the card pages, which the bears never appear on. It is hidden on
      // exactly one layer: the résumé, where two full-bleed white pages of
      // paper sit behind everything and a dark line of text across the bottom
      // of the paper reads as a mistake.
      const bearGroup = document.querySelectorAll<HTMLElement>('.bears');
      const credit = document.querySelector<HTMLElement>('.credit')!;
      function showLayer(id: string | null) {
        allLayers.forEach((l) => l.classList.remove('active'));
        // null means "hide everything", which the callers do mid-pan before the
        // next layer is revealed — so it is a real state, not a missing id
        const t = id ? document.getElementById(id) : null;
        if (t) {
          t.classList.add('active');
          const scroller = t.querySelector<HTMLElement>('.sec-scroll');
          if (scroller) scroller.scrollTop = 0;
        }
        // a layer with a sign in it gets the bears; a card list does not, and
        // neither does the résumé — it is a page of paper, not a way out
        const onSignPage = t !== null && t.querySelector('.sign-wrap') !== null;
        bearGroup.forEach((el) => el.classList.toggle('bears-away', !onSignPage));
        // …and the attribution goes the other way: everywhere except the résumé
        credit.classList.toggle('credit-away', t !== null && t.id === 'layer-resume');
      }

      // ════════════════════════════════════════════════════════════════
      // THE WORLD — one canvas paints one continuous scene
      //
      // The landing page is this scene at camera (0, 0). A section page is
      // the very same scene: a run ends on a whole number of world periods,
      // and every part of the world tiles seamlessly, so you always land on
      // the identical view. So a run is nothing but this same environment
      // sliding past you — translation only. Never a cross-fade between two
      // different worlds, never rotation.
      //
      //   camX > 0 : world slides left  → you went right
      //   camX < 0 : world slides right → you went left
      // The camera has no vertical axis at all: every run is a level traverse,
      // and the view never drifts with the cursor.
      // ════════════════════════════════════════════════════════════════

      const worldCanvas = document.getElementById('world') as HTMLCanvasElement;
      const wctx = worldCanvas.getContext('2d')!;
      let W = 0,
        H = 0,
        dpr = 1;

      // ─── Mode: day, night, and the hour between them ────────────────
      // Switching modes used to snap, which made the world look like a
      // lightbox rather than a place. It now travels: the two palettes are
      // read out of the stylesheet and mixed through a golden hour in the
      // middle, while a sun crosses the far ridge and the stars come out the
      // other side. Nothing here restates a colour that the CSS already owns
      // — the only literal is GOLD, which has no counterpart in the palette.
      const VARS = [
        '--bg',
        '--ink',
        '--muted',
        '--accent',
        '--sky-hi',
        '--sky-lo',
        '--mtn-far',
        '--mtn-mid',
        '--mtn-near',
        '--snow',
        '--snow2',
        '--tree-1',
        '--tree-2',
        '--tree-3',
        '--tree-4',
        '--sign-bg',
        '--sign-txt',
        '--post',
      ];
      // The light a few minutes either side of the horizon. The ground goes
      // warm before the sky does, and the firs go to silhouettes.
      const GOLD: Record<string, string> = {
        '--bg': '#e8cda6',
        '--ink': '#3a2a2b',
        '--muted': '#7d5f4a',
        '--accent': '#ffb340',
        '--sky-hi': '#c9542a',
        '--sky-lo': '#f6b26b',
        '--mtn-far': '#a8674c',
        '--mtn-mid': '#74402f',
        '--mtn-near': '#452521',
        '--snow': '#f9dcc0',
        '--snow2': '#cf9a72',
        '--tree-1': '#7f6247',
        '--tree-2': '#614533',
        '--tree-3': '#422d22',
        '--tree-4': '#251a14',
        '--sign-bg': '#2a1c10',
        '--sign-txt': '#f7e3c0',
        '--post': '#6a3d1a',
      };
      // The hour the sun is NOT in the sky. This view faces west, so switching
      // to day is a sunrise with the sun behind the viewer — which means the
      // scene is lit from the front, not hazed by a low sun, and there is no
      // fiery band to pass through.
      //
      // It is WARM, not neutral: dawn is an orange light, and a sunrise with
      // none reads as a grey fade rather than as morning. The warmth is
      // concentrated where it actually shows — `--sky-lo`, the horizon band,
      // and `--snow`, the largest single area on screen, both run around 40%
      // saturation, while the top of the sky stays a dusky violet because that
      // is what a dawn overhead really is.
      //
      // What it must NOT do is get bright. `GOLD` sits at near-day luminance
      // (bg 208) because the sun is in frame to justify it, and reusing that
      // here put 90% of the luminance change into the first half — that was
      // the lurch, not the colour. `DAWN` holds every value near the MIDPOINT
      // of night and day instead, so the brightness change is spread evenly
      // across the transition. Warmth is free at a fixed luminance: measured
      // per frame, peak luminance change 3.21 → 3.16 and saturation swing
      // 1.43 → 1.47 against the cool version, and 6.13 / 7.70 for the old
      // GOLD-on-the-way-up. The chroma swing is what the eye reads as a jolt.
      const DAWN: Record<string, string> = {
        '--bg': '#9b8b7d',
        '--ink': '#2b2520',
        '--muted': '#6e5f52',
        '--accent': '#ffb340',
        '--sky-hi': '#4a4256',
        '--sky-lo': '#ab7648',
        '--mtn-far': '#7d6a5c',
        '--mtn-mid': '#5c4a40',
        '--mtn-near': '#40332c',
        '--snow': '#e3d3bd',
        '--snow2': '#b0a08c',
        '--tree-1': '#6e6250',
        '--tree-2': '#574b3d',
        '--tree-3': '#3d3a2c',
        '--tree-4': '#211d17',
        '--sign-bg': '#2a1f14',
        '--sign-txt': '#f5edd8',
        '--post': '#5c3d1e',
      };
      // Whichever hour the current change is passing through. GOLD on the way
      // down, DAWN on the way up.
      let MID: Record<string, string> = GOLD;

      function hexToRgb(hex: string): [number, number, number] {
        let h = hex.trim().replace('#', '');
        if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
        const n = parseInt(h, 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      function mixHex(a: string, b: string, t: number): string {
        const A = hexToRgb(a);
        const B = hexToRgb(b);
        return `rgb(${A.map((v, i) => Math.round(v + (B[i] - v) * t)).join(' ')})`;
      }
      // day → the hour → night, meeting at the halfway point.
      function mixAt(v: string, day: string, night: string, t: number): string {
        return t < 0.5 ? mixHex(day, MID[v], t * 2) : mixHex(MID[v], night, (t - 0.5) * 2);
      }

      // Both palettes are read straight off the CSS, by briefly wearing each
      // mode, so the stylesheet stays the only place a colour is written down.
      function readAll(mode: string): Record<string, string> {
        const prev = root.dataset.mode;
        root.dataset.mode = mode;
        const out: Record<string, string> = {};
        for (const v of VARS) out[v] = getVar(v);
        if (prev) root.dataset.mode = prev;
        else root.removeAttribute('data-mode');
        return out;
      }
      const PAL_DAY = readAll('day');
      const PAL_NIGHT = readAll('night');

      type Palette = {
        starAlpha: number; // 0 by day, 1 at full night
        skyHi: string;
        skyLo: string;
        mtnFar: string;
        mtnMid: string;
        mtnNear: string;
        snow: string;
        snow2: string;
        tree1: string;
        tree2: string;
        tree3: string;
        tree4: string;
      };
      // 0 is day, 1 is night, anything between is the sun on its way.
      let blend = root.dataset.mode === 'night' ? 1 : 0;
      function pal(): Palette {
        const t = blend;
        const c = (v: string) => mixAt(v, PAL_DAY[v], PAL_NIGHT[v], t);
        return {
          starAlpha: t,
          skyHi: c('--sky-hi'),
          skyLo: c('--sky-lo'),
          mtnFar: c('--mtn-far'),
          mtnMid: c('--mtn-mid'),
          mtnNear: c('--mtn-near'),
          snow: c('--snow'),
          snow2: c('--snow2'),
          // fir tones, palest (farthest) to darkest (nearest)
          tree1: c('--tree-1'),
          tree2: c('--tree-2'),
          tree3: c('--tree-3'),
          tree4: c('--tree-4'),
        };
      }
      // The page around the canvas has to travel too, or the cards and the
      // sign snap while the snow behind them fades. Inline properties beat
      // any selector, so these hold until the transition ends and are then
      // dropped, leaving the stylesheet back in sole charge.
      function paintChrome(t: number) {
        for (const v of VARS) {
          root.style.setProperty(v, mixAt(v, PAL_DAY[v], PAL_NIGHT[v], t));
        }
      }
      function releaseChrome() {
        for (const v of VARS) root.style.removeProperty(v);
      }

      // ─── Ridgelines ─────────────────────────────────────────────────
      // Periodic value noise: smooth, and identical at u = 0 and u = 1, so
      // a ridge drawn tile after tile has no seam anywhere in it.
      function noise1d(seed: number, n: number) {
        const r = srng(seed);
        const v = Array.from({ length: n }, () => r());
        return (u: number) => {
          const x = u * n,
            i = Math.floor(x),
            f = x - i;
          const a = v[((i % n) + n) % n],
            b = v[(((i + 1) % n) + n) % n];
          const s = f * f * (3 - 2 * f); // smoothstep
          return a + (b - a) * s;
        };
      }
      function fbm1d(seed: number) {
        const a = noise1d(seed + 977, 3),
          b = noise1d(seed + 1951, 6),
          c = noise1d(seed + 2903, 12),
          d = noise1d(seed + 4013, 24);
        return (u: number) => (a(u) + 0.5 * b(u) + 0.25 * c(u) + 0.125 * d(u)) / 1.875;
      }
      type Ridge = { xf: number; hf: number }[];
      // hf = height as a fraction of viewport height, measured from the bottom
      function makeRidge(seed: number, lo: number, hi: number, samples = 120): Ridge {
        const n = fbm1d(seed);
        const pts: Ridge = [];
        for (let i = 0; i <= samples; i++) {
          const u = i / samples;
          // the exponent keeps the shoulders low and the peaks pointed
          pts.push({ xf: u, hf: lo + (hi - lo) * Math.pow(n(u), 1.55) });
        }
        return pts;
      }
      const RIDGE_FAR = makeRidge(11, 0.7, 0.9);
      const RIDGE_MID = makeRidge(29, 0.44, 0.7);
      const RIDGE_NEAR = makeRidge(47, 0.26, 0.54);

      // ─── Forests ────────────────────────────────────────────────────
      // One tile of firs per world period, repeated, so the forest is
      // continuous forever. Three depth bands per shoulder of the run: a
      // treeline along the crest, mid-slope firs, then big foreground firs
      // that frame the run and carry the speed of the pan.
      //
      // Spacing is stratified, not free random: each band is cut into n equal
      // slots and every slot gets exactly one fir, nudged off its slot centre by
      // a seeded jitter. Pure random clumps the shoulder and leaves bald patches;
      // this keeps the stand evenly spaced with organic irregularity on top.
      //
      // Every band is placed by `d0`/`d1` — how far it stands *below the snow
      // crest*, in units of H — never by an absolute screen line, so a fir follows
      // the crest down at the sides of the viewport instead of hanging in the air.
      // `d` doubles as the depth key the forest is sorted by, farthest first.
      //
      // Four flat tones instead of two, so a thick shoulder reads as a forest
      // and not one dark mass: the treeline stays the palest (haze), and each
      // nearer band picks between its own pair — `tones` — as it is laid out,
      // dealt round-robin from a seeded offset so both always appear. The left
      // shoulder carries `extraL` more firs than the right, so the forest is
      // deliberately denser on the left and no longer symmetrical.
      const JITTER = 0.38; // how far off its slot centre a fir may sit
      type Tree = { xf: number; d: number; s: number; tone: number };
      type Band = {
        n: number;
        extraL: number;
        tones: number[];
        tonesL?: number[];
        x0: number;
        x1: number;
        d0: number;
        d1: number;
        s0: number;
        s1: number;
      };
      const FIRS: Tree[] = (() => {
        const r = srng(83);
        const out: Tree[] = [];
        const bands: Band[] = [
          {
            n: 12,
            extraL: 6,
            tones: [0],
            x0: -0.04,
            x1: 0.26,
            d0: 0.0,
            d1: 0.035,
            s0: 0.07,
            s1: 0.125,
          },
          {
            n: 10,
            extraL: 5,
            tones: [1, 2],
            x0: -0.02,
            x1: 0.22,
            d0: 0.055,
            d1: 0.135,
            s0: 0.13,
            s1: 0.215,
          },
          {
            n: 8,
            extraL: 3,
            tones: [2, 3],
            // The left foreground leans darker than the right: this cycle has
            // two dark firs for each light one, where the right is an even
            // [2,3]. The seeded offset decides where in the cycle it starts,
            // so the weighting is a ratio, not a fixed count per fir.
            tonesL: [3, 3, 2, 2],
            x0: -0.06,
            x1: 0.14,
            d0: 0.185,
            d1: 0.4,
            s0: 0.23,
            s1: 0.47,
          },
        ];
        for (const mirror of [false, true]) {
          // left shoulder, then right
          for (const b of bands) {
            const n = b.n + (mirror ? 0 : b.extraL); // thicker on the left
            const slotX = (b.x1 - b.x0) / n;
            const slotD = (b.d1 - b.d0) / n;
            // the left shoulder may weight its cycle differently from the right
            const tones = mirror ? b.tones : (b.tonesL ?? b.tones);
            const toneAt = Math.floor(r() * tones.length); // where the cycle starts
            for (let i = 0; i < n; i++) {
              const jx = (r() - 0.5) * 2 * JITTER;
              const jd = (r() - 0.5) * 2 * JITTER;
              let xf = b.x0 + (i + 0.5 + jx) * slotX; // one fir per slot, never two
              if (mirror) xf = 1 - xf;
              out.push({
                xf,
                d: b.d0 + (i + 0.5 + jd) * slotD,
                s: b.s0 + r() * (b.s1 - b.s0),
                tone: tones[(i + toneAt) % tones.length],
              });
            }
          }
        }
        return out.sort((p, q) => p.d - q.d); // farthest first, nearest last
      })();

      // A PNW spire fir: a bare leader tip, then nine tiers of long branches that
      // hang and overlap one another. Each tier is a downward chevron, and because
      // they all overlap the union is solid — no gaps for the snow to show through —
      // while the sides still serrate the way snow-laden branches do. The lowest
      // tier ends on a shallow flat hem, so the fir sits on its trunk and on the
      // snow instead of tapering away to a point.
      function fir(x: number, baseY: number, h: number, col: string) {
        const half = h * 0.2; // half the width at the branches' base
        const apex = baseY - h;
        const trunkH = h * 0.09;
        const hemY = baseY - trunkH; // the lowest branches end here
        const tiers = 9;
        const hang = h * 0.26; // how deep an inner tier's arms droop
        const top = apex + h * 0.13; // the bare leader above the first arms
        const step = (hemY - top) / tiers; // one tier per step... and the last
        // one hangs just one step deep, so
        // the bottom stays flat, not cupped
        const widthAt = (y: number) => half * Math.pow((y - apex) / (hemY - apex), 0.85);

        wctx.fillStyle = col;
        const trunkW = Math.max(1.2, half * 0.15);
        wctx.fillRect(x - trunkW / 2, hemY, trunkW, trunkH); // the trunk it stands on

        const lead = widthAt(top);
        wctx.beginPath(); // the leader, up to a point
        wctx.moveTo(x, apex);
        wctx.lineTo(x + lead, top);
        wctx.lineTo(x - lead, top);
        wctx.closePath();
        wctx.fill();

        for (let i = 0; i < tiers; i++) {
          // the branches, each hanging a level
          const y = top + i * step;
          const w = widthAt(y);
          const lowest = i === tiers - 1;
          const d = lowest ? step : Math.min(hang, hemY - y);
          wctx.beginPath();
          wctx.moveTo(x - w, y);
          wctx.lineTo(x + w, y);
          if (lowest) {
            // the bottom hem: level in the middle, the arms drooping at the sides
            wctx.quadraticCurveTo(x + w * 0.7, y + d * 0.78, x + w * 0.42, y + d);
            wctx.lineTo(x - w * 0.42, y + d);
            wctx.quadraticCurveTo(x - w * 0.7, y + d * 0.78, x - w, y);
          } else {
            wctx.quadraticCurveTo(x + w * 0.62, y + d * 0.5, x, y + d);
            wctx.quadraticCurveTo(x - w * 0.62, y + d * 0.5, x - w, y);
          }
          wctx.closePath();
          wctx.fill();
        }
      }

      // ─── Stars overhead ─────────────────────────────────────────────
      const STARS = (() => {
        const r = srng(7);
        return Array.from({ length: 220 }, () => ({
          xf: r(),
          yf: r() * 0.55,
          rad: 0.35 + r() * 0.9,
          a: 0.25 + r() * 0.65,
        }));
      })();

      // ─── Drawing ────────────────────────────────────────────────────
      const wrap = (v: number, m: number) => ((v % m) + m) % m;
      // How far below the viewport the filled ground has to run. It is the
      // deepest dive plus a margin, because `draw` translates the world up by
      // cam.y and everything below this line would otherwise be a gap.
      const FLOOR = () => H + MAX_DIVE() + 200;

      // One ridge, tiled across the viewport at its own depth, so the three
      // ridgelines drift at different speeds and give the scene its depth.
      function drawRidge(ridge: Ridge, camX: number, depth: number, col: string) {
        const off = wrap(camX * depth, W);
        wctx.fillStyle = col;
        wctx.beginPath();
        wctx.moveTo(-off - W, FLOOR());
        for (let tile = -1; tile <= 1; tile++) {
          const tileX = tile * W - off;
          for (const p of ridge) wctx.lineTo(tileX + p.xf * W, H * (1 - p.hf));
        }
        wctx.lineTo(2 * W - off, FLOOR());
        wctx.closePath();
        wctx.fill();
      }

      // ─── The snow line ──────────────────────────────────────────────
      // One quadratic crest, shared by the slope fill and by the firs, so every
      // tree stands on the ground. The crest falls away at the two sides of the
      // viewport and rides highest through the middle; a fir is planted on that
      // curve instead of on a fixed line, which is what used to leave the
      // treeline hovering over the snow at the edges.
      const CREST_F = 0.7; // the crest, as a fraction of H
      const CREST_DROP = 0.075; // how far it falls away at each side
      const CREST_LIFT = 0.055; // ...and how far it rides up through the middle
      const CREST_PAD = 60; // the slope is drawn this far past each side

      function snowTopY(x: number): number {
        const yEdge = H * (CREST_F + CREST_DROP);
        const yMid = H * (CREST_F - CREST_LIFT);
        const t = Math.min(1, Math.max(0, (x + CREST_PAD) / (W + CREST_PAD * 2)));
        const u = 1 - t;
        return u * u * yEdge + 2 * u * t * yMid + t * t * yEdge;
      }

      // The run underfoot: one unbroken field of snow, filled with a single
      // gradient. Nothing is drawn on it — the trees and the ridges overhead
      // are what slide past and show you that you are moving.
      function drawSlope(p: Palette) {
        const crest = H * CREST_F;
        const g = wctx.createLinearGradient(0, crest - H * 0.06, 0, H + 120);
        g.addColorStop(0, p.snow);
        g.addColorStop(1, p.snow2);
        wctx.fillStyle = g;
        wctx.beginPath();
        wctx.moveTo(-CREST_PAD, FLOOR());
        wctx.lineTo(-CREST_PAD, snowTopY(-CREST_PAD));
        wctx.quadraticCurveTo(
          W * 0.5,
          H * (CREST_F - CREST_LIFT),
          W + CREST_PAD,
          snowTopY(W + CREST_PAD),
        );
        wctx.lineTo(W + CREST_PAD, FLOOR());
        wctx.closePath();
        wctx.fill();
      }

      // The forest is drawn as one forest, not tile by tile: every visible fir
      // goes into one list sorted by depth, so a pale far tree can never end up
      // painted over a dark near one from the tile next door.
      type Placed = {
        x: number;
        y: number;
        h: number;
        tone: number;
        d: number;
      };
      const PLACED: Placed[] = [];

      function drawFirs(camX: number, p: Palette, camY: number) {
        const tones = [p.tree1, p.tree2, p.tree3, p.tree4];
        const off = wrap(camX, W);
        // the visible band of the world moves down by camY, since the world is
        // drawn translated up by that much — without this, the near firs would
        // be culled as you dive and the foreground would empty out
        const top = camY - 120;
        const bottom = H + camY + 120;
        PLACED.length = 0;
        for (let tile = -1; tile <= 2; tile++) {
          const tileX = tile * W - off;
          for (const t of FIRS) {
            // never let a fir be wider than a fifth of the screen (phones)
            const h = Math.min(t.s * H, W * 0.55);
            const sx = tileX + t.xf * W;
            if (sx < -h || sx > W + h) continue; // off to the side
            // planted on the snow, not on a fixed line: the ground it stands on is
            // the crest curve at its own x, and `d` is how far below that it is
            const sy = snowTopY(sx) + t.d * H;
            if (sy - h > bottom || sy < top) continue; // off the top or bottom
            PLACED.push({ x: sx, y: sy, h, tone: t.tone, d: t.d });
          }
        }
        PLACED.sort((a, b) => a.d - b.d); // farthest first
        for (const t of PLACED) fir(t.x, t.y, t.h, tones[t.tone]);
      }

      function drawStars(camX: number, p: Palette) {
        if (p.starAlpha <= 0.002) return;
        const off = wrap(camX * 0.03, W);
        for (const s of STARS) {
          wctx.beginPath();
          wctx.arc(wrap(s.xf * W - off, W), s.yf * H, s.rad, 0, Math.PI * 2);
          // they come out as the sun goes down, and go in as it comes up
          wctx.fillStyle = `rgba(255,255,255,${(s.a * p.starAlpha).toFixed(3)})`;
          wctx.fill();
        }
      }

      // ─── The sun ─────────────────────────────────────────────────────
      // On screen only while the mode is changing. It is drawn BEFORE the far
      // ridge, so the ridge cuts it in half as it goes down behind it — the
      // same trick as a real horizon, and the reason it reads as setting
      // rather than as a disc shrinking.
      const SUN_XF = 0.63; // where it sits across the viewport
      const SUN_R = 24; // radius, in CSS pixels
      // Its path is absolute, measured in H, rather than relative to the far
      // ridge. The ridge still hides it — a tall peak swallows the sun sooner
      // than a low shoulder, which is the honest result — but the arc no longer
      // depends on where the ridge happens to be, so the sun is reliably on
      // screen for the middle of the change. It starts just off the top and
      // finishes below the highest point the far ridge ever reaches (0.92 of
      // H), so it is never left hanging in the sky at full night.
      const SUN_TOP = -0.08; // × H
      const SUN_END = 0.34; // × H
      const SUN_WARM = '#ffd489';

      function drawSun(t: number) {
        // A rising sun would be behind the viewer, so there is only ever one
        // going down. It is also never drawn at rest — day and night each hide
        // it completely, so the two resting scenes are exactly as they were.
        if (!sunSets || t <= 0.002 || t >= 0.998) return;
        const x = W * SUN_XF;
        const y = H * (SUN_TOP + (SUN_END - SUN_TOP) * t);
        if (y < -SUN_R || y > H) return;
        // A flat disc, like everything else in here. It fades in as it clears
        // the top of the frame rather than popping into existence.
        wctx.globalAlpha = Math.min(1, t / 0.16);
        wctx.fillStyle = SUN_WARM;
        wctx.beginPath();
        wctx.arc(x, y, SUN_R, 0, Math.PI * 2);
        wctx.fill();
        wctx.globalAlpha = 1;
      }

      // ─── Camera ─────────────────────────────────────────────────────
      // `y` is the descent into the snow, and it is the one movement on this
      // site that is not a run: every run is horizontal, and the only way down
      // is the scroll. It is a plain translate of the whole scene, so nothing
      // in the drawing code has to know about it — except the fills, which
      // have to reach far enough below to still cover the screen once the
      // world has been pushed up, and the fir cull, which has to follow it.
      const cam = { x: 0, y: 0 };
      // How far down you can go. At 0.7 of the viewport the snow crest has
      // risen past the top of the frame and the screen is nothing but snow.
      const MAX_DIVE = () => H * 0.7;

      function draw() {
        const p = pal();
        wctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        // the dive: the whole world slides up as you scroll down into it
        wctx.translate(0, -cam.y);
        const sky = wctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, p.skyHi);
        sky.addColorStop(1, p.skyLo);
        wctx.fillStyle = sky;
        wctx.fillRect(0, 0, W, H);
        drawStars(cam.x, p);
        drawSun(p.starAlpha);
        drawRidge(RIDGE_FAR, cam.x, 0.06, p.mtnFar);
        drawRidge(RIDGE_MID, cam.x, 0.18, p.mtnMid);
        drawRidge(RIDGE_NEAR, cam.x, 0.4, p.mtnNear);
        drawSlope(p);
        drawFirs(cam.x, p, cam.y);
      }

      function resize() {
        dpr = Math.min(2, window.devicePixelRatio || 1);
        W = window.innerWidth;
        H = window.innerHeight;
        worldCanvas.width = Math.round(W * dpr);
        worldCanvas.height = Math.round(H * dpr);
        worldCanvas.style.width = W + 'px';
        worldCanvas.style.height = H + 'px';
        // the dive is a fraction of the viewport, so a shorter window has a
        // shallower one — re-clamp or the old offset is out of range
        if (cam.y > MAX_DIVE()) cam.y = MAX_DIVE();
        if (diveOffset > cam.y) {
          diveOffset = cam.y;
          setDive();
        }
      }

      // ─── The run: pan the camera through the scene you are looking at ─
      type Dir = 'left' | 'upleft' | 'up' | 'upright' | 'right';
      const GOES_LEFT: Record<Dir, boolean> = {
        left: true,
        upleft: true,
        up: false,
        upright: false,
        right: false,
      };
      // Reverses the camera's travel, not the arrow. An angled run mirrors to its
      // opposite angle; an upright run went right for one period, so it mirrors to
      // upleft, the one-period run to the left.
      const MIRROR: Record<Dir, Dir> = {
        left: 'right',
        right: 'left',
        upleft: 'upright',
        up: 'upleft',
        upright: 'upleft',
      };
      const PERIODS_STRAIGHT = 2; // world periods a green / double-black run crosses
      const PERIODS_ANGLED = 1; // ...and a blue / black one. Whole periods every
      //    time, so the trees and the ground come back
      //    identical. No run ever climbs or drops.
      const PAN_MS = 1600; // the time a two-period run takes; a shorter run
      // takes proportionally less, so the world always
      // slides past at the very same speed.
      // (Angled runs traverse level, just like the
      // straight ones — only half as far.)

      let pan: {
        t0: number;
        dur: number;
        fx: number;
        tx: number; // the anchors it runs between
        revealed: boolean;
        onReveal: () => void;
      } | null = null;

      let raf = 0;
      function schedule() {
        if (!raf) raf = requestAnimationFrame(tick);
      }

      // A run always crosses a whole number of world periods, so wherever it
      // starts from, it stops on the same stretch of ground. Clicking while a run
      // is already in flight is not ignored: you turn around and ski back.
      function runPan(dir: Dir, onReveal: () => void) {
        const straight = dir === 'left' || dir === 'right';
        const sign = GOES_LEFT[dir] ? -1 : 1;
        const total = W * (straight ? PERIODS_STRAIGHT : PERIODS_ANGLED);
        const anchor = Math.round(cam.x / W) * W; // the nearest settled view
        const tx = anchor + sign * total;
        const span = Math.abs(tx - cam.x);
        pan = {
          t0: performance.now(),
          dur: Math.max(300, PAN_MS * (span / (W * PERIODS_STRAIGHT))), // one speed
          fx: cam.x,
          tx,
          revealed: false,
          onReveal,
        };
        schedule();
      }

      // Smooth in and out at both ends, so the run starts and stops gently.
      const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

      function tick(ts: number) {
        raf = 0;
        let more = false;

        if (pan) {
          const t = Math.min((ts - pan.t0) / pan.dur, 1);
          const p = easeInOut(t);
          cam.x = pan.fx + (pan.tx - pan.fx) * p;
          if (!pan.revealed && p >= 0.7) {
            pan.revealed = true;
            pan.onReveal();
          }
          if (t < 1) more = true;
          else pan = null; // the camera stays where it stopped
        }

        draw();
        if (more) schedule();
      }

      // ─── Navigation ─────────────────────────────────────────────────
      let lastDir: Dir = 'left';
      // The way back, so Back retraces the runs you took to get here — the sub-sign
      // returns to the trail map, and each list returns to the sub-sign.
      let current = 'layer-landing';
      const trail: string[] = [];

      // Forward: a run you pick. Where you came from goes on the trail, so Back
      // can retrace it. The Back row is excluded — it is a sign's own way home, not
      // a run, and it is handled below.
      document.querySelectorAll<HTMLButtonElement>('.run-btn:not([data-back])').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = 'layer-' + btn.dataset.target!;
          const dir = btn.dataset.dir as Dir;
          lastDir = dir;
          // a run is always a level traverse: if the visitor had dived part of
          // the way into the snow, that offset is dropped before they set off
          cam.y = 0;
          diveOffset = 0;
          setDive();
          releaseReveal();
          trail.push(current);
          current = target;

          showLayer(null); // the sign and your name slide away as you push off
          if (reduced) {
            showLayer(target);
            return;
          }
          runPan(dir, () => showLayer(target)); // pushing off along the traverse
        });
      });

      // Back, in one place and one behaviour, for both kinds. A card page's Back
      // carries the direction it retraces, rendered onto the button's arrow at
      // build time from the run that reached it — so the arrow and the pan are
      // driven by ONE value and cannot disagree. A sign's own Back row carries
      // its own `data-dir` for the same reason: it pans the way its own arrow
      // points, because it is a run like any other. `MIRROR[lastDir]` is the
      // fallback for a Back with no direction of its own. Either way it returns
      // to the layer it was reached from — so a sign nested under another sign
      // goes home to the sign above it rather than to the map.
      //
      // It deliberately does NOT set `lastDir`: that must keep meaning "the run you
      // skied to get here", or two Backs in a row would mirror an already-mirrored
      // direction and drift further off course each time.
      document.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const back = trail.pop() || 'layer-landing';
          const dir = (btn.dataset.dir as Dir) || MIRROR[lastDir];
          current = back;
          showLayer(null);
          if (reduced) {
            showLayer(back);
            return;
          }
          runPan(dir, () => showLayer(back));
        });
      });

      // ─── The résumé: down from the landing ─────────────────────────
      // The one movement here that is not a run, so it is the one that does
      // not pan sideways: the world simply slides up as you scroll, the sky
      // and the ridges leave the top of the frame, and the snow fills it.
      // The camera still never drifts and still never rotates — `cam.y` is a
      // straight translate of a scene that is otherwise only ever moved, not
      // redrawn, so the world you land on is the world you left.

      // The document itself, as plain images: no PDF toolbar, no zoom strip, no
      // editor border, and nothing that behaves differently on iOS. Mounted on
      // first reveal rather than sitting in the markup, because 787KB of résumé
      // is a lot to ask of every visit to a ski trail map.
      const resumePages = document.getElementById('resume-pages')!;
      let pagesMounted = false;
      function mountPages() {
        if (pagesMounted) return;
        pagesMounted = true;
        const list: string[] = JSON.parse(resumePages.dataset.pages || '[]');
        resumePages.innerHTML = list
          .map(
            (src, i) =>
              '<figure class="rp"><div class="rp-window">' +
              '<img src="' +
              src +
              '" alt="Resume, page ' +
              (i + 1) +
              ' of ' +
              list.length +
              '" loading="lazy" decoding="async" width="1240" height="1754"></div></figure>',
          )
          .join('');
      }

      // The scroll is 1:1 with the wheel, so it feels like a page rather than a
      // gesture, and it is clamped: the dive has a floor and does not run away.
      // `diveOffset` is the same distance as cam.y, handed to the DOM through
      // --dive so the sign and the bears travel with the snow instead of
      // hanging in the air above it.
      let diveOffset = 0;
      // The landing's hint that the wheel goes deeper. Keyed off `diveOffset`
      // in `setDive()` rather than the wheel handler, because that is the one
      // place the world's offset changes — so the cue comes back by itself
      // everywhere the world returns to the top: scrolling up out of the snow,
      // and taking a run (which drops the offset to 0 before setting off).
      // It cannot disagree with the dive about where the top is.
      const diveCue = document.getElementById('dive-cue')!;
      function setDive() {
        root.style.setProperty('--dive', (-diveOffset).toFixed(1) + 'px');
        diveCue.classList.toggle('is-taken', diveOffset > 2);
      }
      function diveTo(y: number) {
        const max = MAX_DIVE();
        cam.y = Math.max(0, Math.min(max, y));
        diveOffset = cam.y;
        setDive();
        setReveal(cam.y);
        draw();
      }
      // The last stretch of the dive crossfades the trail map into the résumé
      // rather than switching pages at the bottom, so the page is already
      // standing there as you arrive. Both layers have their opacity written
      // inline — the résumé layer is not `.active` through this, so it stays
      // unclickable until the dive actually finishes.
      const landingLayer = document.getElementById('layer-landing') as HTMLElement;
      const resumeLayer = document.getElementById('layer-resume') as HTMLElement;
      const REVEAL_FROM = 0.55; // the fraction of the dive it starts to appear
      function setReveal(y: number) {
        const t = (y / MAX_DIVE() - REVEAL_FROM) / (1 - REVEAL_FROM);
        if (t <= 0) {
          landingLayer.style.opacity = '';
          resumeLayer.style.opacity = '';
          landingLayer.classList.remove('revealing');
          resumeLayer.classList.remove('revealing');
          return;
        }
        const k = Math.min(1, t);
        landingLayer.classList.add('revealing');
        resumeLayer.classList.add('revealing');
        landingLayer.style.opacity = (1 - k).toFixed(3);
        resumeLayer.style.opacity = k.toFixed(3);
      }
      // hand the opacities back to the stylesheet before showLayer runs, or the
      // inline values would beat the `.active` rule and freeze the page half-faded
      function releaseReveal() {
        landingLayer.style.opacity = '';
        resumeLayer.style.opacity = '';
        landingLayer.classList.remove('revealing');
        resumeLayer.classList.remove('revealing');
      }
      // The résumé is a page, not part of the descent, so the world comes back
      // to rest as it arrives rather than staying parked half-sunk. Eased over
      // the same 350ms the layer takes to fade in, so the two land together.
      function settleDown(dur: number) {
        const from = diveOffset;
        if (from === 0) return;
        const t0 = performance.now();
        const step = () => {
          const k = Math.min(1, (performance.now() - t0) / dur);
          diveOffset = from * (1 - k * k * (3 - 2 * k));
          setDive();
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
      function reachedTheBottom() {
        if (current !== 'layer-landing') return;
        if (cam.y < MAX_DIVE() - 1) return; // still descending
        trail.push(current);
        current = 'layer-resume';
        mountPages();
        releaseReveal();
        showLayer('layer-resume');
        if (reduced) {
          diveOffset = 0;
          setDive();
        } else {
          settleDown(350);
        }
      }

      // Momentum: the wheel that took you down often keeps going, and this page
      // is now too short to scroll, so the first flick up is usually the tail
      // of the gesture that got you here. A little travel has to build up
      // before it counts as a way out, so going back is deliberate rather than
      // a rebound off the bottom of the dive.
      const BACK_COMMIT = 36;
      let backRun = 0;
      const resumeScroller = document.querySelector<HTMLElement>('#layer-resume .sec-scroll')!;
      // One wheel handler for both directions, and it has to be able to
      // preventDefault: coming back up is a gesture now, not only a click.
      // The rule for going back is at the TOP of the page and no further — the
      // résumé is taller than a phone, so if any upward scroll surfaced the
      // trail map you could never read the thing you came for. Scroll to the
      // top, keep going, and the world rises back out of the snow.
      window.addEventListener(
        'wheel',
        (e) => {
          if (diveRaf) return; // a rise is already in flight; don't fight it
          if (current === 'layer-landing') {
            // a sideways flick is a pan gesture, not a scroll
            if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
            diveTo(cam.y + e.deltaY);
            reachedTheBottom();
            return;
          }
          if (current !== 'layer-resume') return;
          if (e.deltaY >= 0 || resumeScroller.scrollTop > 0) {
            backRun = 0;
            return; // the page scrolls first
          }
          backRun += -e.deltaY;
          if (backRun < BACK_COMMIT) return;
          backRun = 0;
          e.preventDefault();
          surface();
        },
        { passive: false },
      );

      // Touch: drag up to dive, drag down at the top of the page to surface.
      let touchY: number | null = null;
      window.addEventListener(
        'touchstart',
        (e) => {
          touchY = e.touches[0].clientY;
        },
        { passive: true },
      );
      window.addEventListener(
        'touchmove',
        (e) => {
          if (touchY === null || diveRaf) return;
          const dy = touchY - e.touches[0].clientY;
          touchY = e.touches[0].clientY;
          if (current === 'layer-landing') {
            diveTo(cam.y + dy);
            reachedTheBottom();
          } else if (current === 'layer-resume' && dy < 0 && resumeScroller.scrollTop === 0) {
            surface();
          }
        },
        { passive: true },
      );
      window.addEventListener('touchend', () => {
        touchY = null;
      });

      // The way back up is the same dive in reverse, and it is animated so the
      // world rises rather than cutting. One rAF, independent of the pan's.
      let diveRaf = 0;
      function surface() {
        if (diveRaf) cancelAnimationFrame(diveRaf);
        const back = trail.pop() || 'layer-landing';
        current = back;
        releaseReveal();
        if (reduced) {
          cam.y = 0;
          diveOffset = 0;
          setDive();
          draw();
          showLayer(back);
          return;
        }
        const from = cam.y;
        const t0 = performance.now();
        const up = () => {
          const k = Math.min(1, (performance.now() - t0) / 650);
          const e = 1 - Math.pow(1 - k, 3); // ease out: it leaves quickly, settles
          cam.y = from * (1 - e);
          // the bears and the sign rise back down with the world, not on their
          // own clock — they are standing in it
          diveOffset = cam.y;
          setDive();
          draw();
          if (k < 1) diveRaf = requestAnimationFrame(up);
          else {
            diveRaf = 0;
            cam.y = 0;
            diveOffset = 0;
            setDive();
            draw();
            showLayer(back);
          }
        };
        showLayer(back);
        diveRaf = requestAnimationFrame(up);
      }

      window.addEventListener('resize', () => {
        resize();
        draw();
      });

      resize();
      draw();
    </script>
  </body>
</html>

<style is:global>
  /* ─── Variables ───────────────────────────────── */
  :root {
    --bg: #f3ece2;
    --ink: #3b2a3f;
    --muted: #7a6577;
    /* No peach: the old coral sat around 2.5:1 on the cream, too low for link
     text and weak for the entry rule. Accents fall back to the ink, which is
     high contrast in both modes; night ski still overrides this with amber. */
    --accent: var(--ink);
    --sky-hi: #2188c9;
    --sky-lo: #a8d8f2;
    --mtn-far: #7caec8;
    --mtn-mid: #4d8aaa;
    --mtn-near: #2f6682;
    --snow: #eef3f8;
    --snow2: #c8d8e4;
    /* fir tones, farthest / palest to nearest / darkest */
    --tree-1: #8aafc4;
    --tree-2: #6f9aa4;
    --tree-3: #47705c;
    --tree-4: #1e4024;
    --sign-bg: #2a1f14;
    --sign-txt: #f5edd8;
    --post: #5c3d1e;
  }
  [data-mode='night'] {
    --bg: #0b1510;
    --ink: #ede6d8;
    --muted: #a3afa0;
    --accent: #ffb340;
    --sky-hi: #020d18;
    --sky-lo: #091d30;
    --mtn-far: #0d2018;
    --mtn-mid: #091510;
    --mtn-near: #050d08;
    --snow: #b0c4d0;
    --snow2: #7a99ab;
    /* fir tones, farthest / palest to nearest / darkest */
    --tree-1: #0d2015;
    --tree-2: #0a1a11;
    --tree-3: #07130c;
    --tree-4: #040e07;
    --sign-bg: #1a1208;
    --sign-txt: #e8d9b8;
    --post: #3a2510;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* iOS Safari inflates text on phones in landscape, which silently changes
     every clamp() in this file. Pin it so the mobile layout is the one that
     was actually designed. */
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    overflow: hidden;
    /* Longhands, not the `font` shorthand. The shorthand RESETS
       font-variation-settings, and the production minifier reorders these
       declarations so the shorthand lands LAST — which silently threw the
       axes away in the built site and rendered Fraunces with its default,
       sharper cuts. With no shorthand there is nothing left to reset, so the
       axes survive minification whatever order the declarations land in. */
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.65;
    font-variation-settings: 'SOFT' 100;
    background: var(--bg);
    color: var(--ink);
  }

  /* ─── Mode button ────────────────────────────── */
  #mode-btn {
    /* The one element that inverts between modes: a dark plate on the pale
       page, a pale chip on the dark one, so it always reads against whatever
       background it is sitting on. Both fills are existing palette colours. */
    --btn-fill: var(--sign-bg);
    --btn-hover: var(--post);
    --btn-text: var(--sign-txt);
    position: fixed;
    /* safe-area insets keep the button clear of a notch or a home indicator */
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    z-index: 300;
    font:
      600 0.95rem 'Barlow Condensed',
      sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--btn-fill);
    color: var(--btn-text);
    /* No visible border, like every other flat surface here. The 2px is kept
       only to hold the button's size, and it is painted in the fill colour —
       following it on hover too, so no ring appears when the button fills. */
    border: 2px solid var(--btn-fill);
    border-radius: 7px;
    padding: 0.3rem 1rem;
    cursor: pointer;
    transition:
      background 0.3s,
      border-color 0.3s,
      color 0.3s;
  }
  /* Night: the page is spruce, so the button flips to the sign's cream with
     the board's near-black for the label. */
  [data-mode='night'] #mode-btn {
    --btn-fill: var(--sign-txt);
    --btn-hover: var(--ink);
    --btn-text: var(--sign-bg);
  }
  /* fills in with the same brown as the cap and the Back row, so the button
     is the sign's own timber rather than a plate bolted to it */
  #mode-btn:hover {
    background: var(--btn-hover);
    border-color: var(--btn-hover);
  }
  #mode-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ─── World: one canvas paints the whole scene ─ */
  /* Landing page, runs and section pages are all this canvas at
   different camera positions — nothing else draws scenery. */
  #world {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: var(--bg);
  }

  /* ─── Layers ─────────────────────────────────── */
  .layer {
    position: fixed;
    inset: 0;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .layer.active {
    opacity: 1;
    pointer-events: all;
  }
  /* The last stretch of the dive crossfades the trail map into the résumé
     instead of switching pages at the bottom, so the class transition has to
     stand aside while the opacity is being written per frame. Without this
     it would lag a third of a second behind every notch. */
  .layer.revealing {
    transition: none;
  }
  /* The résumé is the one layer that has to sit IN FRONT of the credit rather
     than under it: its paper runs the full height of the screen, and a fixed
     line of text pinned to the bottom would ride over the document. 30 clears
     the bears and the credit (both 20) and still sits under the mode
     button (300). */
  #layer-resume {
    z-index: 30;
  }

  /* ─── Landing layer ──────────────────────────── */
  #layer-landing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* the sign stands mid-page, not on the snow line */
    /* the content centres in the box *inside* the padding, so this top pad
     walks the sign down by half of it — a nudge, not a drop to the floor.
     .sub-layer uses the same value, so both signs sit at the same height. */
    padding-top: 11vh;
  }
  .site-header {
    position: absolute;
    top: clamp(2.8rem, 9vh, 4.8rem);
    left: 0;
    right: 0;
    text-align: center;
    pointer-events: none;
    padding-inline: 1.25rem; /* the name and line never touch the edge */
  }
  .site-header h1 {
    /* longhands only — see the note on `body` about the font shorthand */
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: clamp(2.2rem, 7.6vw, 4.9rem);
    font-weight: 700;
    line-height: 1;
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1,
      'opsz' 144;
    color: var(--sign-txt);
  }

  /* ─── Dive cue ─────────────────────────────── */
  /* The wheel on this page does something nothing else says it does: it dives,
     and the résumé comes up out of the snow. The page itself never scrolls, so
     without this the gesture is invisible until you happen to try it.

     It is a flex child of the same centred column the sign is in, so it sits
     directly under the post at any window height — the one placement that
     follows the sign instead of guessing at it, which a `bottom:` offset
     cannot do once the bears take the foot of a phone.

     But being the last child of a `justify-content: center` column, it would
     push the sign up by half its own box, and the landing sign is meant to sit
     level with the sub-signs. So the two margins are equal and opposite:
     `margin-top: --cue-gap` sets the air under the post, and `margin-bottom`
     cancels the height **and** the gap, leaving the cue contributing NOTHING to
     the column and the sign exactly where it was. `--cue-gap` is the whole
     knob — change it and the cue moves, the sign does not. It is `clamp()`ed on
     vh because a short phone has no room to give. Measured A/B on the built
     page, hiding the cue and re-measuring: the sign is at `230..672` either
     way, **delta 0px**, with the cue sitting `--cue-gap` lower. Do not "tidy"
     the negative margin away.

     Colour is `--post`, the same brown the credit uses for small text on
     snow — dark in both modes, so nothing to switch. Sentence case, not
     uppercase: "ALL CAPS labels" is on the Avoid list. */
  .dive-cue {
    --cue-h: 2.8rem; /* the box, which the two margins below cancel */
    /* The air between the post and the cue, scaled on vh. It has to shrink on
       a short phone: a 390x667 window already has the bears' heads level with
       the bottom of the sign, so anything more than a few px here walks the
       cue straight across them. 1.5rem is the desktop cap. */
    --cue-gap: clamp(0rem, 2.7vh, 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: var(--cue-h);
    margin-top: var(--cue-gap);
    /* cancels BOTH the height and the gap, so the cue drops by exactly
       --cue-gap while the sign above it stays where it was. Cancel only the
       height and the sign rides up by half the gap. */
    margin-bottom: calc(-1 * (var(--cue-h) + var(--cue-gap)));
    color: var(--post);
    opacity: 0.66;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  /* CSS owns the size, as it does for every other arrow on the site. Plain
     `svg`, not `:global(svg)`: this style block is `is:global`, where
     `:global()` is meaningless. */
  .dive-cue svg {
    width: 14px;
    height: 14px;
  }
  .dive-cue span {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 0.88rem;
    line-height: 1;
    letter-spacing: 0.06em;
  }
  /* Taken the hint: gone, rather than riding along down the page */
  .dive-cue.is-taken {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .dive-cue {
      transition: none;
    }
  }

  /* ─── Trail sign ─────────────────────────────── */
  /* Flat by design: solid fills, no borders, no drop shadows, no gradients
   and no motion. The only softness is the corner radius. */
  .sign-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sign-cap {
    font:
      700 clamp(1.35rem, 3.4vw, 1.7rem) 'Barlow Condensed',
      sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: var(--post);
    color: var(--sign-txt);
    padding: 0.4rem 2.6rem;
    border-radius: 10px 10px 0 0;
    /* A tab, not a bar. Do not pin this to the board's width: a full-length cap
     reads as a header strip, and the overhang is what makes it a sign cap.
     The cap is the post's brown, so the sign reads as one piece of timber
     rather than a gold header bolted to a brown one. */
  }
  .sign-board {
    background: var(--sign-bg);
    /* the board is also the sign's dark brown frame, showing between the runs
     and around the edge — so the `padding` and the `gap` below are both
     frame thickness, not just spacing */
    padding: 0.78rem 0.92rem;
    /* a real width, not just min-width: the board is a content-sized flex
     item, so min-width alone would leave it at its narrowest */
    width: min(480px, 90vw);
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    /* rounded on all four: the cap is narrower than the board, so the board's
     top corners stick out and are what the eye reads as the sign's top two.
     Leaving them square while the bottom pair was rounded was the mismatch. */
    border-radius: 10px;
  }
  .post-shaft {
    width: 18px;
    height: 84px;
    background: var(--post);
    border-radius: 0 0 4px 4px;
  }
  .run-btn {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    padding: 0.65rem 0.95rem;
    border: 0; /* the UA gives <button> a 2px border */
    appearance: none; /* ...and a grey background on some engines */
    border-radius: 7px;
    cursor: pointer;
    text-align: left;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    position: relative;
    overflow: hidden;
  }
  /* hover is a flat wash of light, never a move or a scale */
  .run-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.18s;
  }
  .run-btn:hover::after {
    opacity: 1;
  }
  .run-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .run-green {
    background: #1b6238;
    color: #caf0db;
  }
  .run-blue {
    background: #163672;
    color: #c4d8ff;
  }
  .run-black {
    background: #1c1c1c;
    color: #ddd;
  }
  .run-dblack {
    background: #0e0e0e;
    color: #ccc;
  }
  /* Back to the map. Not a difficulty, so it is not given one: it wears the
   post's brown, the same as the cap and the sign's timber, and carries no
   rating symbol. A rating colour here would claim a grade the run does not
   have — and double black, of all things, is the hardest run on the board. */
  .run-back {
    background: var(--post);
    color: var(--sign-txt);
  }
  .run-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }
  .run-arrow svg {
    width: clamp(34px, 4.6vw, 44px);
    height: auto;
  }
  .run-label {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
  }
  /* never wraps: a taller row on one sign than the other would undo the point
   of them being the same object. The board is wide enough at every size. */
  .run-name {
    font-size: clamp(1.1rem, 2.6vw, 1.38rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  /* the difficulty symbol rides the right-hand end of its row, like the
   rating plate on the far end of a real sign.

   Sized by HEIGHT, not width, and that is what keeps the four in agreement.
   Every viewBox here is 18 units tall with a 14-unit glyph centred in it, so
   one shared height lands all four shapes on the same pixel height — and
   since each is centred in its own box, on the same centre line too. The
   double black's box is wider (31 units, for two diamonds) so its width
   follows from its own aspect ratio; no hand-tuned multiplier needed. */
  .run-tag {
    --sym-h: clamp(21px, 2.9vw, 28px);
    --sym-w: calc(var(--sym-h) * 31 / 18); /* the double black: the widest case */
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sym-w); /* one box for all four… */
    flex-shrink: 0; /* …so the centres must not be squeezed */
    opacity: 0.8;
  }
  .run-tag svg {
    height: var(--sym-h);
    width: auto;
  }

  /* Standing still: ask for less motion and the pan does not happen. */
  @media (prefers-reduced-motion: reduce) {
    .layer {
      transition: none;
    }
    /* no pan means no transition to hide behind, so the bears snap */
    .bear,
    .bears-away .bear,
    .credit.credit-away {
      transition: none;
    }
  }

  /* ─── Section layers — text overlaid on world ─── */
  .section-layer {
    overflow: hidden;
  }

  .sec-scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    /* On a phone this is the only thing that scrolls, so it should not
       rubber-band the page behind it when it reaches the end. */
    overscroll-behavior: contain;
    /* NOT -webkit-overflow-scrolling: touch. It forces a composited scrolling
       layer, which tears position: sticky. The résumé used to be the only
       sticky thing here and showed the tearing; it no longer uses sticky at
       all, so this is belt-and-braces. It is a legacy shim for iOS 12 and
       earlier anyway; the phone block scopes it. */
  }

  .sec-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2.5rem 2rem 6rem;
  }
  /* 780px, not 700: the phone rules below key off max-width 779px, and an
     overlapping pair means both apply in 700–779px with source order deciding
     it. Disjoint is the only way that stays predictable. */
  @media (min-width: 780px) {
    .sec-inner {
      padding: 3rem 3.5rem 7rem;
    }
  }

  /* The way back, on a list page. A solid --post chip rather than an outline:
     the outlined version was only 4.5:1 on the cream in day mode, and a hairline
     on a busy background reads as faint. A solid chip is 6.7:1, and it is
     deliberately the same material as the sign's own Back row, so the button
     looks like the run you came down. Borderless, per the flat design. */
  .back-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font:
      600 0.95rem 'Barlow Condensed',
      sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--post);
    color: var(--sign-txt);
    border: 0; /* the UA gives <button> a 2px border */
    appearance: none;
    border-radius: 7px; /* the run-button radius, so the two match */
    padding: 0.42rem 0.95rem;
    cursor: pointer;
    margin-bottom: 1.6rem;
    overflow: hidden;
  }
  /* a flat wash of light on hover, exactly as a run row does — never a move */
  .back-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.18s;
  }
  .back-btn:hover::after {
    opacity: 1;
  }
  /* the arrow is its own span so the gap comes from `gap`, not a space that
     the uppercasing would leave dangling; it is hidden from screen readers
     because the label already says where you are going. It holds the same
     <Arrow> a run row uses, so the button's arrow IS the sign's arrow — a
     text glyph could not show ↖ or ↗, only ←. */
  .back-btn .back-arrow {
    position: relative;
    display: flex;
    align-items: center;
  }
  .back-btn .back-arrow svg {
    width: 1.05em;
    height: auto;
  }
  .back-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ─── The résumé ────────────────────────────────────────────────
     This page is white paper, so its text is dark in BOTH modes. --post is
     the one palette colour that is: --ink flips to cream at night and would
     vanish against the page. The credit is the same — it sits on snow, which
     is light in both modes, so --muted was never enough to read.

     The link is a tenth of that same brown: a solid --post chip was the
     loudest thing on a field of snow, this is a stain in it, and the chip
     still has an edge you can see the control by. No border, no shadow, no
     gradient, no motion. */
  #layer-resume h2,
  #layer-resume .resume-note {
    text-align: center;
  }
  .resume-note {
    max-width: 32rem;
    margin: 0 auto 1.6rem;
    color: var(--post);
  }
  /* The document, as images. No frame, no shadow, no border: the paper is
     already white on white, and a box around it is exactly the editor chrome
     this is here to avoid.

     There is deliberately NO crop here: no `aspect-ratio`, no `overflow: hidden`,
     no `position: sticky`, and no script. Each sheet is simply as tall as it
     needs to be, so every pixel of the résumé renders, and ordinary document
     scroll carries you down it a screen at a time.

     That is the third attempt at the "see a bit at a time" effect and the only
     one that cannot hide content. The two before it both cropped a portrait
     sheet in a fixed window and then had to MOVE the image to reveal the rest,
     and both failed in ways that only showed up on a real screen:

       - a 100vh window against a 928px sheet left 115px of travel, so the page
         sat still while you scrolled past 3.6k px of dead runway;
       - a square window with the sticky pin dropped cropped 272px of every
         sheet — permanently, because nothing was left to move the image back.

     A static crop is the trap. It only ever looks right until you ask where
     the bottom third went, and the answer is: there is no scroll position that
     reaches it. The whole thing works because the sheet is simply taller than
     the screen. */
  .resume-pages {
    margin-top: 2rem;
  }
  .rp-window {
    background: #fff; /* the paper, so the sheet sits on its own white */
  }
  .rp-window img {
    display: block;
    width: 100%;
    /* height: auto — a forced height would squash the sheet out of its
       page proportions */
    height: auto;
  }
  .rp + .rp {
    margin-top: 3rem;
  }
  .dl-btn {
    /* centred under the heading: fit-content keeps the chip its own width, and
       auto margins do the centring without touching the rest of the column */
    display: block;
    width: fit-content;
    margin-inline: auto;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--post);
    background: color-mix(in srgb, var(--post) 10%, transparent);
    border: 0;
    border-radius: 7px;
    /* still a target worth thumbing, even though it looks like a stain */
    padding: 0.7rem 1.15rem;
    transition: opacity 0.18s ease;
  }
  .dl-btn:hover {
    opacity: 0.75;
  }
  .dl-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .green-badge {
    background: #1b6238;
    color: #caf0db;
  }
  .blue-badge {
    background: #163672;
    color: #c4d8ff;
  }
  .black-badge {
    background: #1c1c1c;
    color: #ddd;
  }
  .dblack-badge {
    background: #0e0e0e;
    color: #ccc;
    border: 1px solid #333;
  }

  h2 {
    /* longhands only — see the note on `body` about the font shorthand */
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: clamp(1.9rem, 5.5vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    font-variation-settings:
      'SOFT' 100,
      'WONK' 1,
      'opsz' 144;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    color: var(--ink);
  }
  /* ─── Cards ───────────────────────────────────────────────
     The section pages are cards rather than a list on bare snow,
     and a card is the sign's own timber. So the text on one is
     the sign's cream, not the page's --ink: that is a dark plum in
     bluebird and would be unreadable against brown. */
  .entries {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }
  /* two columns for the project cards, which carry a screenshot */
  .entries-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (max-width: 720px) {
    .entries-2 {
      grid-template-columns: 1fr;
    }
  }
  .entry {
    --card-ink: var(--sign-txt);
    --card-body: color-mix(in srgb, var(--sign-txt) 88%, transparent);
    /* 84% is the first step that clears 4.5:1 in BOTH modes on --post: at
       72% the dates fall to 3.8:1 in night ski. Do not dim this further. */
    --card-dim: color-mix(in srgb, var(--sign-txt) 84%, transparent);
    --card-line: color-mix(in srgb, var(--sign-txt) 20%, transparent);
    background: var(--post);
    color: var(--card-ink);
    border-radius: 10px;
    padding: 1.05rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
  }
  .eh {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.15rem 1rem;
    margin-bottom: 0.18rem;
  }
  h3 {
    /* longhands only — see the note on `body` about the font shorthand */
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
    font-variation-settings: 'SOFT' 100;
  }

  /* ─── Sub-sign ───────────────────────────────────────────────
   The Experience sign, one level below the landing sign. It is
   the same object — cap, board of runs, post — so it reuses
   .sign-* and .run-* wholesale rather than inventing a second
   visual language. The four rows fan out the way the main sign does:
   first ←, second ↖, third ↗, and Back to the map on the far right. */
  .sub-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 11vh; /* matches #layer-landing, so both signs agree */
  }
  .entry h3,
  .entry h4 {
    color: var(--card-ink);
  }
  .when {
    font:
      500 0.93rem 'Barlow Condensed',
      sans-serif;
    color: var(--card-dim);
    white-space: nowrap;
  }
  .org {
    font:
      500 0.95rem 'Barlow Condensed',
      sans-serif;
    color: var(--card-body);
    margin-bottom: 0.3rem;
  }
  .entry ul {
    padding-left: 1.05rem;
    margin: 0.3rem 0 0;
  }
  .entry li {
    margin: 0.22rem 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--card-body);
  }
  /* One card per organisation, with that org's roles stacked inside it. */
  .org-name {
    font:
      700 1.02rem 'Barlow Condensed',
      sans-serif;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--card-ink);
    padding-bottom: 0.5rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--card-line);
  }
  .role + .role {
    margin-top: 0.95rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--card-line);
  }
  /* The screenshot slot and the repo link, under a project card. */
  .shot {
    aspect-ratio: 16 / 10;
    /* No negative top margin: it used to bleed the image up into the card's
       padding, which is why the top of a project card sat closer to its edge
       than the bottom. The top is now the card's own padding, matching it. */
    margin: 0 0 0.9rem;
    border-radius: 7px;
    overflow: hidden;
    background: color-mix(in srgb, var(--sign-bg) 62%, transparent);
    display: grid;
    place-items: center;
  }
  .shot img {
    width: 100%;
    height: 100%;
    /* Zoom to fill: `cover` scales the image until the frame is completely
       covered, so there is never an unfilled band at any screen size. It does
       crop — the screenshots are 1.24 to 1.65 wide, against a 1.60 frame. */
    object-fit: cover;
    display: block;
  }
  .shot-empty {
    font:
      600 0.78rem 'Barlow Condensed',
      sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sign-txt) 45%, transparent);
  }
  .card-link {
    /* auto margin on the last child of the flex column glues the link to the
       foot of the card, so the links line up across a row of cards of unequal
       height; the padding keeps a minimum gap under the bullets */
    margin-top: auto;
    padding-top: 0.95rem;
    align-self: flex-start;
    font:
      600 0.85rem 'Barlow Condensed',
      sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-ink);
    text-decoration: none;
    padding-bottom: 1px;
    border-bottom: 1px solid color-mix(in srgb, var(--sign-txt) 45%, transparent);
  }
  .card-link:hover {
    border-bottom-color: var(--card-ink);
  }
  .card-link.is-empty {
    color: color-mix(in srgb, var(--sign-txt) 42%, transparent);
    border-bottom-style: dashed;
    cursor: default;
  }

  /* One category per card, so the old two-column definition list is gone:
   the .org-name header is the label and this is what sits under it. */
  .skill-items {
    color: var(--card-body);
    font-size: 0.98rem;
    line-height: 1.55;
    margin-top: 0;
  }

  /* ─── Bears ───────────────────────────────────────────────
   The contact links, standing on the snow either side of the
   sign. `display: contents` lets the two bears position
   themselves against the layer on a wide screen, and fall
   back to a plain row underneath it on a narrow one. */
  .bears {
    display: contents;
  }
  /* A page with no sign under it has no snow beside a signpost, so the bears
     leave. `visibility` is what actually takes them out of the tab order and
     the hit-testing, not just the paint — otherwise an invisible link would
     still be focusable and still be clickable through a card. */
  .bears-away .bear {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.28s ease,
      visibility 0s;
  }
  /* the narrow fallback lays the two out in a row, so the flip has to be undone
   there or one bear would be lying on its side */
  @media (max-width: 779px) {
    .bear:first-of-type img {
      transform: none;
    }
  }
  /* the pair cross-fade in and out rather than snapping. showLayer(null) runs
     mid-pan, so the fade happens while the world is still moving, and the
     bears are back before the next page settles. */
  .bear {
    /* above the .layer pages (z-index 10) so the links stay reachable on
       every page, but below the mode button (300) */
    z-index: 20;
    /* fades, and is untabbable and unclickable while it is out */
    transition:
      opacity 0.28s ease,
      visibility 0s linear 0.28s;
    /* 21% of the image box is empty below the bear's feet, so it is the feet —
     not the box — that get placed on the snow. Everything hangs off --bear-w
     so the two bears scale as one. */
    --bear-w: clamp(118px, 13.5vw, 182px);
    --bear-feet: clamp(3.25rem, 14vh, 7.5rem); /* feet above the viewport bottom */
    --sign-w: min(480px, 90vw); /* the board, to sit just outside */
    --bear-gap: 0.25rem; /* clearance from the board's edge, not the screen's */
    /* the flank label travels with the bear, so the two can never disagree
       about how big the animal is; the phone block pins its own size */
    --bear-label: 1.45rem;
    position: absolute;
    bottom: calc(var(--bear-feet) - var(--bear-w) * 0.21);
    width: var(--bear-w);
    aspect-ratio: 1;
    text-decoration: none;
  }
  /* Just outside the board's edge, not pinned to the screen: the board is
   centred, so its edge is half the leftover width. This keeps the bears a
   fixed gap from the sign at every window size instead of drifting away
   from it on a wide screen. Stays positive from ~780px up, which is where
   the narrow fallback below takes over. */
  .bear:first-of-type {
    left: calc((100vw - var(--sign-w)) / 2 - var(--bear-w) - var(--bear-gap));
  }
  .bear:last-of-type {
    right: calc((100vw - var(--sign-w)) / 2 - var(--bear-w) - var(--bear-gap));
  }
  /* the left bear faces the other way, so the pair stand nose to nose */
  .bear:first-of-type img {
    transform: scaleX(-1);
  }
  .bear img {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* The flank is solid from about 5% to 96% across and between 35% and 70%
   down, so the label sits mid-flank, high enough to clear the legs. It is
   mirrored on the flipped bear — the two are mirror images, so matching
   percentages would throw the labels out of symmetry about the centre of
   the page. */
  .bear-text {
    position: absolute;
    left: 56%;
    top: 44%;
    transform: translate(-50%, -50%);
    width: 70%;
    text-align: center;
    line-height: 1.1;
    /* longhands, so the size can come off the bear and not be restated */
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: var(--bear-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #f3e3ce; /* cream on the bear's brown flank */
    overflow-wrap: anywhere;
  }
  .bear:first-of-type .bear-text {
    left: 44%;
  }
  .bear:hover {
    opacity: 0.85;
  }
  .bear:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 12px;
  }

  .credit {
    position: fixed;
    z-index: 20; /* travels with the bears — see .bear */
    bottom: 0.7rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    /* dark in both modes: this sits on snow, which is light in both, and it
       has to stay legible over the white résumé page as well */
    color: var(--post);
    opacity: 0.8;
  }
  /* the one place the attribution goes: over the résumé, whose white pages run
     the full height of the screen. `visibility` is what takes it out of the tab
     order, not just the paint. */
  .credit.credit-away {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.28s ease,
      visibility 0s;
  }
  .credit a {
    color: inherit;
  }

  /* Narrow: the sign fills the width, so there is no snow either side of it.
     The bears stay fixed to the foot of the viewport — they are outside every
     layer now, so they cannot simply sit under the sign in flow, or they would
     scroll away with the landing page. */
  @media (max-width: 779px) {
    .bears {
      display: flex;
      justify-content: center;
      gap: 1.4rem;
      /* `position` is load-bearing here: left/right/bottom are inert on a
         static element, which left the pair sitting in normal flow at the top
         of the body — on top of the name and the sign. */
      position: fixed;
      left: 0;
      right: 0;
      bottom: 2.4rem; /* clear of the credit line pinned to the very bottom */
    }
    /* `relative`, not `static`: the bear must stay in the flex row so the pair
       lays out side by side, but it must ALSO stay a containing block, or the
       absolutely-positioned .bear-text inside it stops anchoring to its own
       bear and both labels pile into the middle of the pair. Switching from
       absolute to relative also turns the desktop `left`/`right`/`bottom`
       into relative offsets, so they are neutralised below. */
    .bear {
      position: relative;
      inset: auto;
      width: clamp(80px, 28vw, 118px);
      /* phones keep the label they already had; only the desktop bear grew */
      --bear-label: 1.05rem;
    }
    /* :first-of-type / :last-of-type out-specifies a bare .bear, and a media
       query adds no specificity of its own, so these have to be undone there
       too or the desktop offsets still apply as relative shifts. */
    .bear:first-of-type,
    .bear:last-of-type {
      left: auto;
      right: auto;
    }
  }

  /* ─── The dive ──────────────────────────────────────────────────
     The canvas slides up as you scroll, and everything standing IN
     the world has to go with it — the sign and your name are DOM, not
     canvas, so without this they hang in the air while the snow moves
     out from under them. One length, `--dive`, is set per frame from
     cam.y.

     It is NOT a CSS transition: the wheel already supplies the easing,
     and a transition on top would lag a frame behind every notch.

     `.bear` is named rather than `.bears`, because on a wide screen
     `.bears` is `display: contents` and generates no box at all — a
     transform on it would silently do nothing. The bears are the
     actual boxes, on both layouts. */
  #layer-landing .site-header,
  #layer-landing .sign-wrap,
  #layer-landing .dive-cue,
  .bear,
  .credit {
    transform: translateY(var(--dive, 0px));
  }

  /* ─── Mobile ──────────────────────────────────────────────────
     The scene is full-bleed, so a phone sees less of it and the same
     words sit over different ground than they do on a wide screen.
     Everything here is phone-only: the desktop look is untouched. */
  @media (max-width: 779px) {
    /* momentum scrolling, iOS only. In the base rule this tears the résumé's
       sticky windows, so it lives here with the other phone-only bits. */
    .sec-scroll {
      -webkit-overflow-scrolling: touch;
    }
    /* a scrim behind the copy, inset from the screen edges so the world
       still shows either side, and faded top and bottom so the scene runs
       into it rather than being cut off. Desktop gets none of this. */
    .sec-inner {
      padding: 1.75rem 0.75rem 7rem;
    }
    /* Deliberately nothing here to back the heading up. A wash behind it was
       reverted twice as a "weird background overlay", and a text-shadow halo
       was turned down after that. The h2 sits on the world on mobile exactly
       as it does on desktop — the owner has seen both and prefers it clean.
       The cards are opaque --post panels and the back button is a solid chip,
       so nothing else on a card page touches the scene either. */
    /* a touch target worth thumbing */
    .back-btn {
      padding: 0.6rem 1.05rem;
      font-size: 1rem;
    }
    .credit {
      font-size: 0.7rem;
      padding-inline: 1rem;
      bottom: max(0.7rem, env(safe-area-inset-bottom));
    }
    /* the mode button is the one undersized target on a phone; give it a thumb */
    #mode-btn {
      top: max(0.75rem, env(safe-area-inset-top));
      right: max(0.75rem, env(safe-area-inset-right));
      padding: 0.55rem 0.9rem;
      font-size: 1rem;
    }
  }

  /* A phone in landscape is ~390px tall, and the sign is ~398px: it
     overflows. The post is the only part that can give, and nobody looks
     at a signpost's leg, so it is what shrinks. Paired with `orientation`
     so a short desktop window does not get a stubby post on a wide screen. */
  @media (max-height: 520px) and (orientation: landscape) {
    .post-shaft {
      height: 34px;
    }
    .sub-layer,
    #layer-landing {
      padding-top: 4vh;
    }
    .bears {
      bottom: 1.6rem;
    }
  }
</style>
